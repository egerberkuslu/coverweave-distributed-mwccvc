session CoverWeave_Base in "." = Cook_Levin +
  options [timeout = 1800]
  theories
    MWCCVC_Graph
    MWCCVC_Language
    MWCCVC_Verifier_Spec
    MWCCVC_NP_Assembly
    TM_Helpers

session CoverWeave_Reduce in "reduce" = CoverWeave_Base +
  options [timeout = 3600]
  theories
    TM_Reduce

session CoverWeave_Grow in "grow" = CoverWeave_Base +
  options [timeout = 3600]
  theories
    TM_Grow

session CoverWeave_Owner in "owner" = CoverWeave_Base +
  options [timeout = 3600]
  theories
    TM_Owner

session CoverWeave_NP in "final" = CoverWeave_Base +
  options [timeout = 3600]
  sessions
    CoverWeave_Reduce
    CoverWeave_Grow
    CoverWeave_Owner
  theories
    TM_Verify
    MWCCVC_NP
